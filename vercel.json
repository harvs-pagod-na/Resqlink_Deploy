{
  "buildCommand": "cd Resqlink/frontend && npm install && npm run build",
  "outputDirectory": "Resqlink/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://resqlink-backend-4bwq.onrender.com/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://resqlink-backend-4bwq.onrender.com/uploads/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://resqlink-backend-4bwq.onrender.com/socket.io/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
