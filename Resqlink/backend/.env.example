# ─────────────────────────────────────────────────────────────
# GAWAN KE — Backend Environment Variables
# Copy this to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3000
APP_NAME=GAWAN_KE
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=resqlink_db
DB_USER=root
DB_PASS=

# JWT
JWT_ACCESS_SECRET=change_this_super_secret_access_key_at_least_64_chars
JWT_REFRESH_SECRET=change_this_super_secret_refresh_key_at_least_64_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis (optional, for caching & blacklisting)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASS=

# AI Microservice
AI_SERVICE_URL=http://localhost:5001
AI_FACE_THRESHOLD=0.80

# Email (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM=GAWAN KE <noreply@gawanke.ph>

# SMS (Semaphore PH)
SMS_PROVIDER=semaphore
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=GAWANKE

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
MAX_RESUME_SIZE_MB=5

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Security
BCRYPT_ROUNDS=12
OTP_EXPIRY_MINUTES=10
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
