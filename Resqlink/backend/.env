# ─── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ─── Database (XAMPP MySQL defaults) ─────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=resqlink_db
DB_USER=root
DB_PASS=

# ─── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=resqlink_access_secret_dev_2026
JWT_REFRESH_SECRET=resqlink_refresh_secret_dev_2026
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Email (optional for local dev) ──────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=noreply@resqlink.gov.ph
MAIL_PASS=your_email_password
MAIL_FROM="RESQLINK <noreply@resqlink.gov.ph>"

# ─── Upload ───────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# ─── AI Service ───────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:5001
AI_FACE_THRESHOLD=0.80

# ─── Rate Limiting ────────────────────────────────────────────
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
